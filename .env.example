PORT=3000
NODE_ENV=development
DEFAULT_ALIAS=prod
FEATURED_PRIMARY_ALIAS=prod
TITLE_ID=20CA2
OS=iOS
PLAYFAB_DEVICE_ID=vmc-replace-with-a-stable-random-id

EXPOSE_SENSITIVE_CATALOG_FIELDS=false
EXPOSE_SENSITIVE_EVENT_FIELDS=false

JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=1
LOG_LEVEL=info

ENABLE_DOCS=false
VALIDATE_REQUESTS=false
VALIDATE_RESPONSES=false
ENABLE_SALES_WATCHER=false
ENABLE_ITEM_WATCHER=true
ENABLE_CONTENT_UPDATE_WATCHER=true
ENABLE_SUBSCRIPTION_WATCHER=true
ENABLE_FEATURED_CONTENT_WATCHER=true

WATCHER_OVERLAP_MS=900000
WATCHER_RECONCILE_LOOKBACK_MS=604800000
WATCHER_RECONCILE_INTERVAL_MS=21600000

CATALOG_INDEX_SYNC_ENABLED=true
